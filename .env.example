# TaxPulse settings. setup.bat copies this file to .env – edit .env, never commit it.

# Anthropic API key (create one at https://platform.claude.com). Needed from step 3 onwards.
ANTHROPIC_API_KEY=

# Claude models used by the agents
MODEL_REASONING=anthropic/claude-sonnet-5-5
MODEL_FAST=anthropic/claude-haiku-5-5

# Relevance score (0-100) from which a match becomes an alert
ALERT_THRESHOLD=60
